+# The dashboard admin password. The team picks it and the pipeline passes it in
+# (ADMIN_PASSWORD GitHub secret), so it is never in the repo and the same login comes
+# back after a full teardown. Write-only: it is not kept in state or in the plan file.
+# To change it: update the GitHub secret and raise secret_string_wo_version by 1.
+resource "aws_secretsmanager_secret" "admin_password" {
+  name       = "${var.project_name}-${var.environment}-admin-password"
+  kms_key_id = aws_kms_key.secret_encryption.arn
+
+  # dev only: delete immediately so destroy/apply cycles can reuse the name; prod keeps the default 30-day recovery window
+  recovery_window_in_days = 0
+}
+
+resource "aws_secretsmanager_secret_version" "admin_password" {
+  secret_id = aws_secretsmanager_secret.admin_password.id
+
+  secret_string_wo         = var.admin_password
+  secret_string_wo_version = 1
+}
+
+# The secret shared with the carrier to sign webhook calls. The carrier has to be given the
+# same value, so it cannot be random: the pipeline passes it in (CARRIER_WEBHOOK_SECRET
+# GitHub secret). Write-only, like the admin password; to change it, update the GitHub
+# secret and raise secret_string_wo_version by 1, and give the carrier the new value.
+resource "aws_secretsmanager_secret" "carrier_webhook_secret" {
+  name       = "${var.project_name}-${var.environment}-carrier-webhook-secret"
+  kms_key_id = aws_kms_key.secret_encryption.arn
+
+  # dev only: delete immediately so destroy/apply cycles can reuse the name; prod keeps the default 30-day recovery window
+  recovery_window_in_days = 0
+}
+
+resource "aws_secretsmanager_secret_version" "carrier_webhook_secret" {
+  secret_id = aws_secretsmanager_secret.carrier_webhook_secret.id
+
+  secret_string_wo         = var.carrier_webhook_secret
+  secret_string_wo_version = 1
+}
+
 resource "aws_secretsmanager_secret" "db_credentials" {
