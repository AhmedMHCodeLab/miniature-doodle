From: Ahmed <ahmedmh03.work@gmail.com>
Date: Wed, 7 Oct 2026 04:17:26 +0300
Subject: [PATCH] fix(inventory-service): refuse to commit an order that has no
 active hold

/commit answered 200 'committed 0' for a hold the scheduler had expired, so a paid order
could finish without the stock leaving the shelf. It now answers 409 unless the order was
already committed (a repeat is still 200). Deploy after the worker change that handles it.
---
 services/inventory-service/main.go      | 21 +++++++-
 services/inventory-service/main_test.go | 65 +++++++++++++++++++++++++
 2 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/services/inventory-service/main.go b/services/inventory-service/main.go
index 8452fb3..eb34ee7 100644
--- a/services/inventory-service/main.go
+++ b/services/inventory-service/main.go
@@ -484,7 +484,8 @@ func handleRelease(w http.ResponseWriter, r *http.Request) {
 
 // handleCommit turns an order's held stock into a sale: stock and reserved both drop by
 // the quantity and the reservation becomes 'committed', which the scheduler never
-// expires. Same claim-then-act pattern as release, so a repeat commits nothing.
+// expires. Same claim-then-act pattern as release, so a repeat commits nothing. An order
+// with no active hold and nothing committed answers 409.
 func handleCommit(w http.ResponseWriter, r *http.Request) {
 	if r.Method != http.MethodPost {
 		httpError(w, "method not allowed", http.StatusMethodNotAllowed)
@@ -534,6 +535,24 @@ func handleCommit(w http.ResponseWriter, r *http.Request) {
 		return
 	}
 
+	if len(items) == 0 {
+		// Nothing active was claimed. A repeat of a commit that already happened is fine (200,
+		// committed 0). But an order whose hold expired, was released or never existed has
+		// not been sold anything: say so (409) instead of reporting a sale that never took
+		// the stock off the shelf. The worker then re-reserves, or cancels and refunds.
+		var committed int
+		if err := tx.QueryRow(
+			"SELECT COUNT(*) FROM reservations WHERE order_id = $1 AND status = 'committed'", req.OrderID,
+		).Scan(&committed); err != nil {
+			httpError(w, "commit failed", http.StatusInternalServerError)
+			return
+		}
+		if committed == 0 {
+			httpError(w, "no active reservation to commit (the hold expired, was released, or was never made)", http.StatusConflict)
+			return
+		}
+	}
+
 	for _, it := range items {
 		if _, err := tx.Exec(
 			"UPDATE products SET stock = stock - $1, reserved = reserved - $1, updated_at = NOW() WHERE id = $2",
diff --git a/services/inventory-service/main_test.go b/services/inventory-service/main_test.go
index e010ca3..0040fe4 100644
--- a/services/inventory-service/main_test.go
+++ b/services/inventory-service/main_test.go
@@ -290,3 +290,68 @@ func TestHoldLengthDoesNotDependOnTheServiceTimeZone(t *testing.T) {
 		}
 	}
 }
+
+// The hold timed out (the scheduler expired it) before the order was committed. Saying
+// "committed" would let a paid order finish without the stock leaving the shelf.
+func TestCommitOfAnExpiredHoldIsRefused(t *testing.T) {
+	setupTestDB(t)
+	post(t, handleReserve, reserveBody(1, 2))
+	db.Exec(`UPDATE reservations SET status = 'expired' WHERE order_id = 1`)
+	db.Exec(`UPDATE products SET reserved = 0`)
+
+	rec := post(t, handleCommit, map[string]int{"order_id": 1})
+	if rec.Code != http.StatusConflict {
+		t.Fatalf("commit of expired hold: got %d, want 409", rec.Code)
+	}
+	if stock := stockCount(t); stock != 5 {
+		t.Errorf("stock = %d, want 5 (nothing sold)", stock)
+	}
+}
+
+func TestCommitOfAnOrderWithNoHoldIsRefused(t *testing.T) {
+	setupTestDB(t)
+	if rec := post(t, handleCommit, map[string]int{"order_id": 99}); rec.Code != http.StatusConflict {
+		t.Fatalf("commit with no hold: got %d, want 409", rec.Code)
+	}
+}
+
+// A hold that was released (the order was cancelled) is not a sale either.
+func TestCommitOfAReleasedHoldIsRefused(t *testing.T) {
+	setupTestDB(t)
+	post(t, handleReserve, reserveBody(1, 2))
+	post(t, handleRelease, map[string]int{"order_id": 1})
+	if rec := post(t, handleCommit, map[string]int{"order_id": 1}); rec.Code != http.StatusConflict {
+		t.Fatalf("commit after release: got %d, want 409", rec.Code)
+	}
+	if stock := stockCount(t); stock != 5 {
+		t.Errorf("stock = %d, want 5", stock)
+	}
+}
+
+// Many commits at once for one order: one takes the stock, the others are repeats (200),
+// never a 409 for an order that really was committed.
+func TestConcurrentCommitsAreAllSuccessfulRepeats(t *testing.T) {
+	setupTestDB(t)
+	post(t, handleReserve, reserveBody(1, 2))
+	codes := make([]int, 20)
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := range codes {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			codes[i] = post(t, handleCommit, map[string]int{"order_id": 1}).Code
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+	for i, c := range codes {
+		if c != http.StatusOK {
+			t.Fatalf("commit %d got %d, want 200", i, c)
+		}
+	}
+	if stock := stockCount(t); stock != 3 {
+		t.Errorf("stock = %d, want 3", stock)
+	}
+}
