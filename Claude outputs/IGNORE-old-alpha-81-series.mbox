+func TestReserveAgainOutageKeepsMessageForRetry(t *testing.T) {
+	_, err := runSeq(t, map[string][]int{"/commit": {409}, "/reserve": {201, 500}}, "pending", orderCreated(t), map[string]int{"/charge": 201})
+	if err == nil {
