diff --git a/services/dashboard-api/static/app.js b/services/dashboard-api/static/app.js
new file mode 100644
index 0000000..754a35d
--- /dev/null
+++ b/services/dashboard-api/static/app.js
@@ -0,0 +1,361 @@
+const API = window.location.origin;
+// The token is kept in memory only, never in localStorage, so it is gone when the
+// tab closes. When it expires (24h) the API answers 401 and the login box comes back.
+let token = '';
+let refreshTimer = null;
+
+async function submitLogin(e) {
+    e.preventDefault();
+    const btn = document.getElementById('login-button');
+    btn.disabled = true;
+    try {
+        const r = await fetch(API + '/auth/login', {
+            method: 'POST',
+            headers: { 'Content-Type': 'application/json' },
+            body: JSON.stringify({
+                email: document.getElementById('login-email').value,
+                password: document.getElementById('login-password').value
+            })
+        });
+        const d = await r.json().catch(() => ({}));
+        if (!r.ok || !d.token) { toast(d.error || 'Login failed', true); return; }
+        token = d.token;
+        document.getElementById('login-password').value = '';
+        document.body.classList.remove('locked');
+        refreshAll();
+        if (!refreshTimer) refreshTimer = setInterval(refreshAll, 30000);
+    } catch (err) {
+        toast('Login failed', true);
+    } finally {
+        btn.disabled = false;
+    }
+}
+
+function showLogin() {
+    token = '';
+    document.body.classList.add('locked');
+}
+
+function headers() {
+    return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
+}
+
+// Errors stay up longer than confirmations, and a new message restarts the clock
+// (before, an earlier message's timer could hide a newer one early).
+let toastTimer;
+function toast(msg, error) {
+    const t = document.getElementById('toast');
+    t.textContent = msg;
+    t.className = error ? 'error' : '';
+    t.style.display = 'block';
+    clearTimeout(toastTimer);
+    toastTimer = setTimeout(() => t.style.display = 'none', error ? 8000 : 4000);
+}
+
+function showTab(name, tabEl) {
+    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
+    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
+    tabEl.classList.add('active');
+    document.getElementById('panel-' + name).classList.add('active');
+    refreshAll();
+}
+
+// Everything that comes back from the API is written into the page with innerHTML,
+// and some of it (the customer email, product ids, notes) is typed by whoever logged in.
+// esc() turns it into plain text first, so "<img onerror=...>" shows up as text
+// instead of running as code in the admin's browser.
+function esc(v) {
+    return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+}
+
+function badge(status) {
+    return `<span class="badge badge-${esc(status)}">${esc(status)}</span>`;
+}
+
+function ts(s) {
+    if (!s) return '-';
+    return new Date(s).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
+}
+
+function money(n) { return '£' + Number(n || 0).toFixed(2); }
+
+// --- Stats ---
+async function loadStats() {
+    try {
+        const r = await fetch(API + '/dashboard/summary', { headers: headers() });
+        if (r.status === 401) { showLogin(); return; }
+        const d = await r.json();
+        document.getElementById('stats').innerHTML = `
+            <div class="card"><div class="card-label">Total Orders</div><div class="card-value blue">${esc(d.orders?.total || 0)}</div></div>
+            <div class="card"><div class="card-label">Today's Orders</div><div class="card-value green">${esc(d.orders?.today || 0)}</div></div>
+            <div class="card"><div class="card-label">Revenue</div><div class="card-value green">${money(d.revenue?.total)}</div></div>
+            <div class="card"><div class="card-label">Low Stock Alerts</div><div class="card-value ${d.inventory?.low_stock > 0 ? 'red' : 'green'}">${esc(d.inventory?.low_stock || 0)}</div></div>
+            <div class="card"><div class="card-label">Active Shipments</div><div class="card-value orange">${esc(d.shipping?.active_shipments || 0)}</div></div>
+        `;
+    } catch(e) { console.error('Stats error', e); }
+}
+
+// --- Orders ---
+async function loadOrders() {
+    try {
+        const r = await fetch(API + '/api/orders/', { headers: headers() });
+        const orders = await r.json();
+        const tbody = document.getElementById('orders-table');
+        if (!orders || !orders.length) { tbody.innerHTML = '<tr><td colspan="7" style="color:#8b949e">No orders yet</td></tr>'; return; }
+        tbody.innerHTML = orders.map(o => {
+            const items = (typeof o.items === 'string' ? JSON.parse(o.items) : o.items) || [];
+            const itemStr = items.map(i => `${esc(i.product_id)} x${esc(i.quantity)}`).join(', ');
+            let actions = '';
+            // No pending -> confirmed button: the worker confirms an order itself, after the payment
+            // has gone through. A manual confirm here would skip the payment.
+            const next = { confirmed: 'processing', processing: 'shipped', shipped: 'delivered' };
+            if (next[o.status]) {
+                actions = `<button class="btn btn-sm btn-blue" data-action="advance" data-id="${Number(o.id)}" data-status="${esc(next[o.status])}">${esc(next[o.status])}</button>`;
+            }
+            if (['pending','confirmed','processing'].includes(o.status)) {
+                actions += ` <button class="btn btn-sm btn-orange" data-action="advance" data-id="${Number(o.id)}" data-status="cancelled">cancel</button>`;
+            }
+            return `<tr><td>${esc(o.id)}</td><td>${esc(o.customer_id)}</td><td>${itemStr}</td><td>${money(o.total)}</td><td>${badge(o.status)}</td><td>${ts(o.created_at)}</td><td>${actions}</td></tr>`;
+        }).join('');
+    } catch(e) { console.error('Orders error', e); }
+}
+
+// Every order carries an Idempotency-Key. If the request gets no clear answer (timeout,
+// dropped connection) and the user clicks again with the same order, the same key is
+// sent, so the order-service returns the first order instead of making a second.
+// crypto.randomUUID() needs https, and dev is http, so build the key from getRandomValues.
+function newKey() {
+    return Array.from(crypto.getRandomValues(new Uint8Array(16)), b => b.toString(16).padStart(2, '0')).join('');
+}
+let lastAttempt = null; // { body, key } of an order that got no clear answer
+let placingOrder = false;
+
+async function createOrder() {
+    if (placingOrder) return;
+    const product = document.getElementById('order-product').value;
+    const qty = parseInt(document.getElementById('order-qty').value) || 1;
+    if (!product) { toast('Pick a product', true); return; }
+
+    const order = { items: [{ product_id: product, quantity: qty }] };
+    // The address is sent when any part is filled in; order-service checks it is complete.
+    const addr = {
+        name: document.getElementById('ship-name').value,
+        line1: document.getElementById('ship-line1').value,
+        city: document.getElementById('ship-city').value,
+        postcode: document.getElementById('ship-postcode').value,
+        country: 'GB'
+    };
+    if (addr.name || addr.line1 || addr.city || addr.postcode) order.shipping_address = addr;
+    const body = JSON.stringify(order);
+    const key = lastAttempt && lastAttempt.body === body ? lastAttempt.key : newKey();
+    lastAttempt = { body, key };
+
+    const btn = document.getElementById('place-order');
+    placingOrder = true;
+    btn.disabled = true;
+    try {
+        const r = await fetch(API + '/api/orders/', {
+            method: 'POST', headers: { ...headers(), 'Idempotency-Key': key }, body
+        });
+        const d = await r.json();
+        if (r.ok) { lastAttempt = null; toast('Order #' + d.id + ' created'); refreshAll(); }
+        else {
+            if (r.status < 500) lastAttempt = null; // a clear "no": the next click is a new order
+            toast(d.error || 'Failed', true);
+        }
+    } catch(e) { toast('Error creating order', true); }
+    finally { placingOrder = false; btn.disabled = false; }
+}
+
+async function advanceOrder(id, status) {
+    try {
+        const r = await fetch(API + '/api/orders/status', {
+            method: 'PUT', headers: headers(),
+            body: JSON.stringify({ order_id: id, new_status: status })
+        });
+        if (r.ok) { toast(`Order #${id} -> ${status}`); refreshAll(); }
+        else { const d = await r.json(); toast(d.error || 'Failed', true); }
+    } catch(e) { toast('Error updating order', true); }
+}
+
+// --- Inventory ---
+// The order form only offers products that exist and have stock. The order-service
+// still checks every order, so this is a convenience, not the guard.
+function populateOrderProducts(products) {
+    const sel = document.getElementById('order-product');
+    const previous = sel.value;
+    sel.replaceChildren();
+    if (!products || !products.length) {
+        sel.add(new Option('No products yet', ''));
+        return;
+    }
+    products.forEach(p => {
+        const avail = p.available ?? (p.stock - p.reserved);
+        const opt = new Option(`${p.name} (${p.id}) - ${money(p.price)} - ${avail} available`, p.id);
+        opt.disabled = avail < 1;
+        sel.add(opt);
+    });
+    // The page refreshes every 30s; keep what the person already picked.
+    const keep = [...sel.options].find(o => o.value === previous && !o.disabled);
+    sel.value = keep ? previous : ([...sel.options].find(o => !o.disabled) || sel.options[0]).value;
+}
+
+async function loadInventory() {
+    try {
+        const r = await fetch(API + '/api/inventory/products', { headers: headers() });
+        const products = await r.json();
+        populateOrderProducts(products);
+        const tbody = document.getElementById('inventory-table');
+        if (!products || !products.length) { tbody.innerHTML = '<tr><td colspan="7" style="color:#8b949e">No products yet</td></tr>'; return; }
+        tbody.innerHTML = products.map(p => {
+            const avail = p.available ?? (p.stock - p.reserved);
+            const color = avail < 10 ? 'color:#f85149' : '';
+            return `<tr><td>${esc(p.id)}</td><td>${esc(p.name)}</td><td>${esc(p.sku)}</td><td>${money(p.price)}</td><td>${esc(p.stock)}</td><td>${esc(p.reserved)}</td><td style="${color}">${esc(avail)}</td></tr>`;
+        }).join('');
+    } catch(e) { console.error('Inventory error', e); }
+}
+
+async function addProduct() {
+    const data = {
+        id: document.getElementById('prod-id').value,
+        name: document.getElementById('prod-name').value,
+        sku: document.getElementById('prod-sku').value,
+        price: parseFloat(document.getElementById('prod-price').value) || 0,
+        stock: parseInt(document.getElementById('prod-stock').value) || 0
+    };
+    if (!data.id || !data.name) { toast('Fill in product details', true); return; }
+    try {
+        const r = await fetch(API + '/api/inventory/products', {
+            method: 'POST', headers: headers(),
+            body: JSON.stringify(data)
+        });
+        if (r.ok) { toast('Product added'); refreshAll(); }
+        else { const d = await r.json(); toast(d.error || 'Failed', true); }
+    } catch(e) { toast('Error adding product', true); }
+}
+
+// --- Payments ---
+async function loadPayments() {
+    try {
+        const r = await fetch(API + '/dashboard/revenue', { headers: headers() });
+        const d = await r.json();
+        document.getElementById('revenue-info').innerHTML = `
+            <div class="grid">
+                <div class="card"><div class="card-label">Charged</div><div class="card-value green">${money(d.total)}</div></div>
+                <div class="card"><div class="card-label">Refunded</div><div class="card-value red">${money(d.refunded)}</div></div>
+                <div class="card"><div class="card-label">Net</div><div class="card-value blue">${money(d.net)}</div></div>
+            </div>
+        `;
+    } catch(e) {}
+
+    try {
+        const r = await fetch(API + '/api/payments/ledger', { headers: headers() });
+        const entries = await r.json();
+        const tbody = document.getElementById('ledger-table');
+        if (!entries || !entries.length) { tbody.innerHTML = '<tr><td colspan="6" style="color:#8b949e">No entries</td></tr>'; return; }
+        tbody.innerHTML = entries.map(e => 
+            `<tr><td style="font-size:0.75rem">${esc(e.payment_id)}</td><td>${badge(e.entry_type)}</td><td>${e.debit > 0 ? money(e.debit) : '-'}</td><td>${e.credit > 0 ? money(e.credit) : '-'}</td><td>${esc(e.description)}</td><td>${ts(e.created_at)}</td></tr>`
+        ).join('');
+    } catch(e) {}
+}
+
+// --- Shipping ---
+async function loadShipping() {
+    try {
+        const r = await fetch(API + '/api/shipping/shipments', { headers: headers() });
+        const shipments = await r.json();
+        const tbody = document.getElementById('shipping-table');
+        if (!shipments || !shipments.length) { tbody.innerHTML = '<tr><td colspan="7" style="color:#8b949e">No shipments</td></tr>'; return; }
+        tbody.innerHTML = shipments.map(s =>
+            `<tr><td>${esc(s.id)}</td><td>${esc(s.order_id)}</td><td>${esc(s.carrier)}</td><td>${esc(s.tracking_number || '-')}</td><td>${badge(s.status)}</td><td>${esc(s.recipient_name)}</td><td>${esc(s.city)}</td></tr>`
+        ).join('');
+    } catch(e) {}
+
+    try {
+        const r = await fetch(API + '/dashboard/shipping/overview', { headers: headers() });
+        const d = await r.json();
+        const statuses = Object.entries(d.by_status || {}).map(([k,v]) => `${badge(k)} ${esc(v)}`).join('&nbsp;&nbsp;');
+        const carriers = Object.entries(d.by_carrier || {}).map(([k,v]) => `${esc(k)}: ${esc(v)}`).join(', ');
+        document.getElementById('shipping-overview').innerHTML = `
+            <p style="margin-bottom:8px">${statuses || 'No shipments'}</p>
+            <p style="color:#8b949e;font-size:0.85rem">Carriers: ${carriers || '-'} | Avg delivery: ${(Number(d.avg_delivery_hours) || 0).toFixed(1)}h</p>
+        `;
+    } catch(e) {}
+}
+
+// --- Notifications ---
+async function loadNotifications() {
+    try {
+        const r = await fetch(API + '/api/notifications/history', { headers: headers() });
+        const notifs = await r.json();
+        const tbody = document.getElementById('notif-table');
+        if (!notifs || !notifs.length) { tbody.innerHTML = '<tr><td colspan="6" style="color:#8b949e">No notifications</td></tr>'; return; }
+        tbody.innerHTML = notifs.map(n =>
+            `<tr><td>${esc(n.id)}</td><td>${esc(n.recipient)}</td><td>${esc(n.channel)}</td><td>${esc(n.template)}</td><td>${badge(n.status)}</td><td>${ts(n.sent_at || n.created_at)}</td></tr>`
+        ).join('');
+    } catch(e) {}
+}
+
+// --- Services ---
+async function loadServices() {
+    const services = [
+        { name: 'api-gateway', url: '/healthz' },
+        { name: 'order-service', url: '/api/orders/healthz' },
+        { name: 'inventory-service', url: '/api/inventory/healthz' },
+        { name: 'payment-service', url: '/api/payments/healthz' },
+        { name: 'notification-service', url: '/api/notifications/healthz' },
+        { name: 'shipping-service', url: '/api/shipping/healthz' },
+        { name: 'dashboard-api', url: '/dashboard/healthz' },
+        { name: 'worker', url: '/dashboard/worker/healthz' },
+        { name: 'scheduler', url: '/dashboard/scheduler/healthz' },
+    ];
+
+    const grid = document.getElementById('services-grid');
+    grid.innerHTML = services.map(s => 
+        `<div class="service-card" id="svc-${s.name}"><span class="service-name">${s.name}</span><span class="dot dot-grey"></span></div>`
+    ).join('');
+
+    for (const s of services) {
+        try {
+            const r = await fetch(API + s.url, { signal: AbortSignal.timeout(3000) });
+            const d = await r.json();
+            const el = document.getElementById('svc-' + s.name);
+            const dot = el.querySelector('.dot');
+            dot.className = d.status === 'ok' ? 'dot dot-green' : 'dot dot-red';
+        } catch(e) {
+            const el = document.getElementById('svc-' + s.name);
+            if (el) el.querySelector('.dot').className = 'dot dot-red';
+        }
+    }
+}
+
+// --- Refresh ---
+function refreshAll() {
+    if (!token) return;
+    loadStats();
+    loadOrders();
+    loadInventory();
+    loadPayments();
+    loadShipping();
+    loadNotifications();
+    loadServices();
+}
+
+// Data loads after login (see submitLogin). Auto-refresh is every 30s: all tabs of
+// one admin share one rate-limit bucket.
+
+// No inline handlers: the page's Content-Security-Policy only allows scripts from this
+// file, so clicks are wired up here instead of with onclick attributes.
+document.getElementById('login-box').addEventListener('submit', submitLogin);
+document.addEventListener('click', (e) => {
+    const tab = e.target.closest('[data-tab]');
+    if (tab) { showTab(tab.dataset.tab, tab); return; }
+    const el = e.target.closest('[data-action]');
+    if (!el) return;
+    switch (el.dataset.action) {
+        case 'refresh': refreshAll(); break;
+        case 'create-order': createOrder(); break;
+        case 'add-product': addProduct(); break;
+        case 'advance': advanceOrder(Number(el.dataset.id), el.dataset.status); break;
+    }
+});
