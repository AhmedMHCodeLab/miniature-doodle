+		t.Fatalf("bad tokens from one IP: got %v, want [401 401 429]", codes)
+	}
+}
+
+// The upstream must see the client's IP in X-Forwarded-For, not Traefik's ip:port.
+func TestForwardedForKeepsTheClientChain(t *testing.T) {
+	setLimits(t, 1000, 1000, 1000, "10.0.0.0/8")
+	var got string
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { got = r.Header.Get("X-Forwarded-For") }))
+	t.Cleanup(up.Close)
+	routes = map[string]string{"/api/orders": up.URL}
+	r := request("GET", "/api/orders/", "10.6.1.20:51000", "") // Traefik pod
+	r.Header.Set("X-Forwarded-For", "198.51.100.7")            // what Traefik saw
+	r.Header.Set("Authorization", "Bearer "+tokenFor(t, "a@test.com"))
+	handleProxy(httptest.NewRecorder(), r)
+	if got != "198.51.100.7, 10.6.1.20" {
+		t.Fatalf("upstream X-Forwarded-For %q, want %q", got, "198.51.100.7, 10.6.1.20")
+	}
+}
+
+// The page's script must load without a token, like the page itself; data still needs one.
+func TestDashboardScriptIsServedWithoutAToken(t *testing.T) {
+	setLimits(t, 1000, 1000, 1000, "")
+	var paths []string
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { paths = append(paths, r.URL.Path) }))
+	t.Cleanup(up.Close)
+	routes = map[string]string{"/dashboard/": up.URL}
+	for _, p := range []string{"/", "/app.js"} {
+		rec := httptest.NewRecorder()
+		handleProxy(rec, request("GET", p, "203.0.113.42:1", ""))
+		if rec.Code != http.StatusOK {
+			t.Errorf("%s without a token: got %d, want 200", p, rec.Code)
+		}
+	}
+	rec := httptest.NewRecorder()
+	handleProxy(rec, request("GET", "/other.js", "203.0.113.42:2", ""))
+	if rec.Code != http.StatusUnauthorized {
+		t.Errorf("/other.js without a token: got %d, want 401", rec.Code)
+	}
+	if len(paths) != 2 || paths[1] != "/app.js" {
+		t.Errorf("upstream saw %v, want [/ /app.js]", paths)
+	}
+}
