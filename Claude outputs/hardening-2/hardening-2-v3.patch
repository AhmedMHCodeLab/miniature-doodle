index 0000000..e020487
--- /dev/null
+++ b/kubernetes/charts/microservice/templates/middleware-ratelimit.yaml
@@ -0,0 +1,16 @@
+{{- if and .Values.ingressRoute.enabled .Values.ingressRoute.rateLimit.enabled }}
+{{- $rl := .Values.ingressRoute.rateLimit }}
+# Per client IP limit at the edge. The NLB keeps the client's address
+# (preserve_client_ip), so Traefik's default source, the remote address, is the client.
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: {{ include "microservice.fullname" . }}-ratelimit
+  labels:
+    {{- include "microservice.labels" . | nindent 4 }}
+spec:
+  rateLimit:
+    average: {{ $rl.average }}
+    period: {{ $rl.period }}
+    burst: {{ $rl.burst }}
+{{- end }}
