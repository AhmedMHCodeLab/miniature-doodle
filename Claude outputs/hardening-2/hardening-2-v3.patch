+func TestEveryResponseCarriesSecurityHeaders(t *testing.T) {
+	setLimits(t, 1000, 1000, 1000, "")
+	fakeUpstream(t)
+	h := securityHeaders(http.HandlerFunc(handleProxy))
+	for _, path := range []string{"/api/orders/", "/healthz", "/no-such-route"} {
+		rec := httptest.NewRecorder()
