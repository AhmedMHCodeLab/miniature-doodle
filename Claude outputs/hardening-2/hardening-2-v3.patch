+			return s.URL
+		}(), "unhealthy", 503},
+		{"not running", down, "unreachable", 503},
+	} {
+		rec := httptest.NewRecorder()
+		backgroundHealth("worker", c.url)(rec, httptest.NewRequest(http.MethodGet, "/dashboard/worker/healthz", nil))
+		var body map[string]string
+		json.NewDecoder(rec.Body).Decode(&body)
+		if rec.Code != c.code || body["status"] != c.want || body["service"] != "worker" {
+			t.Errorf("%s: got %d %v, want %d %s", c.name, rec.Code, body, c.code, c.want)
+		}
+	}
+}
