+var healthClient = &http.Client{Timeout: 2 * time.Second}
+
+// backgroundHealth reports a background service's own /healthz: ok only when it answers 200.
+func backgroundHealth(name, url string) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		status, code := "ok", http.StatusOK
+		resp, err := healthClient.Get(url)
+		if err != nil {
+			status, code = "unreachable", http.StatusServiceUnavailable
+		} else {
+			resp.Body.Close()
+			if resp.StatusCode != http.StatusOK {
+				status, code = "unhealthy", http.StatusServiceUnavailable
+			}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.WriteHeader(code)
+		json.NewEncoder(w).Encode(map[string]string{"status": status, "service": name})
+	}
+}
