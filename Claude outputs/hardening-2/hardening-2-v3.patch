+// webhookSecret is shared with the carrier. Only someone holding it can sign a call.
+var webhookSecret []byte
+
+// verifyCarrierSignature checks the X-Carrier-Signature header, "sha256=" followed by the
+// hex HMAC-SHA256 of the raw body keyed with the shared secret (the same scheme GitHub
+// uses for its webhooks). hmac.Equal compares in constant time, so a caller can't learn
+// the right signature byte by byte from response times.
+//
+// There is no timestamp in the signature, so a captured call could be sent again. That is
+// harmless here: a shipment only ever moves forward and a repeat changes nothing.
+func verifyCarrierSignature(header string, body []byte) bool {
+	got, ok := strings.CutPrefix(header, "sha256=")
+	if !ok {
+		return false
+	}
+	sig, err := hex.DecodeString(got)
+	if err != nil {
+		return false
+	}
+	mac := hmac.New(sha256.New, webhookSecret)
+	mac.Write(body)
+	return hmac.Equal(sig, mac.Sum(nil))
+}
