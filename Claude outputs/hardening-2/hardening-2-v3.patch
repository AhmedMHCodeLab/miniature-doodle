+	var gotEmail, gotRole string
+	up := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotEmail, gotRole = r.Header.Get("X-User-Email"), r.Header.Get("X-User-Role")
