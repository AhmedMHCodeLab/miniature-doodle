 	type line struct {
 		ProductID string `json:"p"`
 		Quantity  int    `json:"q"`
 	}
+	// The address is left out when there is none, so a request without one hashes
+	// exactly as it did before addresses existed (keys stored then still match).
 	canonical := struct {
-		Items    []line `json:"items"`
-		Currency string `json:"currency"`
-		Notes    string `json:"notes"`
-	}{Currency: currency, Notes: notes}
+		Items    []line   `json:"items"`
+		Currency string   `json:"currency"`
+		Notes    string   `json:"notes"`
+		Address  *Address `json:"address,omitempty"`
+	}{Currency: currency, Notes: notes, Address: address}
 	for _, it := range items {
 		canonical.Items = append(canonical.Items, line{it.ProductID, it.Quantity})
 	}
