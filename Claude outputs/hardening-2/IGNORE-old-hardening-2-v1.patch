diff --git a/kubernetes/platform/redis/externalsecret.yaml b/kubernetes/platform/redis/externalsecret.yaml
new file mode 100644
index 0000000..6bc0a2e
--- /dev/null
+++ b/kubernetes/platform/redis/externalsecret.yaml
@@ -0,0 +1,24 @@
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: redis-auth
+  namespace: order-platform
+spec:
+  refreshInterval: 1h
+  secretStoreRef:
+    name: aws-secrets-manager
+    kind: ClusterSecretStore
+  target:
+    name: redis-auth
+    creationPolicy: Owner
+    template:
+      engineVersion: v2
+      data:
+        # Read by redis-server as a config file, so the password is never on the command line.
+        redis.conf: "requirepass {{ .password }}"
+        # Read by redis-cli in the probes (REDISCLI_AUTH).
+        password: "{{ .password }}"
+  data:
+    - secretKey: password
+      remoteRef:
+        key: eks-v2-dev-redis-password
