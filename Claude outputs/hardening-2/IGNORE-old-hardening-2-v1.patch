+			order, fmt.Sprintf("TRK%d", order), status, daysAgo).Scan(&id)
+		if err != nil {
+			t.Fatalf("insert shipment: %v", err)
+		}
+		mustExec(t, `INSERT INTO tracking_events (shipment_id, status, occurred_at) VALUES ($1, $2, NOW())`, id, status)
+		return id
+	}
+	oldDelivered := add(1, "delivered", 91)
+	recentDelivered := add(2, "delivered", 89)
+	oldMoving := add(3, "in_transit", 200) // still moving: the carrier may still need the address
+
+	cleanupOldEvents()
+
+	details := func(id int) int {
+		return countRows(t, `SELECT count(*) FROM shipments WHERE id = $1 AND recipient_name IS NOT NULL AND address_line1 IS NOT NULL AND postcode IS NOT NULL`, id)
